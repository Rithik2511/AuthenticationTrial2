@{
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-lg rounded-4 p-4 p-md-5"
         style="width:100%; max-width:420px;">
        <form action="/Login/CreateAccount" method="post">
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">Create Account</h2>
                <span>Already have an account?<a href="/Login/SignIn">Sign In</a></span>
            </div>
            <div class="mb-3">
                <label for="emailtxt" class="form-label fw-semibold">
                    Email Address
                </label>

                <input type="email"
                       id="emailtxt"
                       class="form-control form-control-lg"
                       name="Username"
                       required />
            </div>
            <div>
                <label for="passwordtxt" class="form-label fw-semibold">
                    Password
                </label>

                <input type="password"
                       id="passwordtxt"
                       class="form-control form-control-lg"
                       name="Password"
                       required />
            </div>
            <div>
                <label for="cnfPasswordtxt" class="form-label fw-semibold">
                    Confirm Password
                </label>

                <input type="password"
                       id="cnfPasswordtxt"
                       class="form-control form-control-lg"
                       name="ConfirmPassword"
                       required />
            </div>
            <button id="submitBtn"
                    type="submit"
                    class="btn btn-primary btn-lg w-100 rounded-3 mb-4">
                Sign Up
            </button>
            <span style="color:red" id="errorDisplayElement"></span>
            <span style="color:green" id="successDisplayElement"></span>
        </form>
    </div>
</div>
<script src="~/scripts/login/register.js"></script>