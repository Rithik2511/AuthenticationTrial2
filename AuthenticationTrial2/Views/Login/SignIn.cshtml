@{
    Layout = null;
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center">

    <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5"
         style="width: 100%; max-width: 450px;">

        <form>

            <!-- Heading -->
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-2">Welcome Back</h2>
                <p class="text-muted">Sign in to continue</p>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label for="emailtxt" class="form-label fw-semibold">
                    Email Address
                </label>

                <input type="email"
                       id="emailtxt"
                       class="form-control form-control-lg"
                       placeholder="Enter your email"
                       required />
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label for="passwordtxt" class="form-label fw-semibold">
                    Password
                </label>

                <input type="password"
                       id="passwordtxt"
                       class="form-control form-control-lg"
                       placeholder="Enter your password"
                       required />
            </div>

            <!-- Remember Me / Forgot Password -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           id="rememberMe"
                           checked />

                    <label class="form-check-label" for="rememberMe">
                        Remember me
                    </label>
                </div>

                <a href="#!" class="text-decoration-none small">
                    Forgot password?
                </a>

            </div>

            <!-- Sign In -->
            <button id="submitBtn"
                    class="btn btn-primary btn-lg w-100 rounded-3 mb-4">
                Sign In
            </button>

            <!-- Register -->
            <div class="text-center">
                <span class="text-muted">Not a member?</span>
                <a href="/Login/Register" class="text-decoration-none fw-semibold">
                    Register
                </a>
            </div>
            <span style="color:red" id="errorDisplayElement"></span>
            <span style="color:green" id="successDisplayElement"></span>
        </form>

    </div>

</div>

<script src="~/scripts/login/signin.js"></script>